{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "functions": {
    "api/update-funds.js": {
      "maxDuration": 60
    },
    "api/funds.js": {
      "maxDuration": 30,
      "includeFiles": "data/funds.json"
    },
    "api/status.js": {
      "maxDuration": 30,
      "includeFiles": "data/funds.json"
    }
  },
  "crons": [
    {
      "path": "/api/update-funds",
      "schedule": "10 22 * * *"
    }
  ]
}
