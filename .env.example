# Required on Vercel if you want manual/cron fund updates to persist.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional but recommended on Vercel. Use this to protect /api/update-funds.
UPDATE_SECRET=

# Optional. "cached" is faster for Vercel serverless; "full" refetches previous/month snapshots too.
FUND_UPDATE_HISTORY_MODE=cached

# Optional local settings.
PORT=5173
PYTHON=
